# Herbatka — local dev configuration
# Copy to .env. Ports live in the 1731x block; see PLAN.md "Port allocation".
# Do not fall back to default ports (5432, 5173, 8000) — Opik and other
# pet-projects already hold those.

# --- host-side ports ---
WEB_PORT=17310
API_PORT=17311
POSTGRES_PORT=17312
ADMINER_PORT=17313

# --- database ---
# Host-side URL (running the API outside Docker):
DATABASE_URL=postgresql+asyncpg://herbatka:herbatka@localhost:17312/herbatka
# Inside the compose network the service listens on the default 5432:
#   postgresql+asyncpg://herbatka:herbatka@db:5432/herbatka
POSTGRES_USER=herbatka
POSTGRES_PASSWORD=herbatka
POSTGRES_DB=herbatka

# --- auth ---
JWT_SECRET=change-me-in-any-non-local-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# OAuth (M1 leaves these blank; the identity table is ready for them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- geocoding (OpenStreetMap Nominatim) ---
# Off by default: the test suite must never depend on a third party being up. Turn it on
# for local use and the admin "Find from address" button starts working. Their policy
# allows one request per second and requires a User-Agent naming the application.
GEOCODING_ENABLED=false

# --- app ---
API_BASE_URL=http://localhost:17311
CORS_ORIGINS=http://localhost:17310
