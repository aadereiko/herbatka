# Herbatka — local dev configuration
# Copy to .env. Ports live in the 1731x block; see PLAN.md "Port allocation".
# Do not fall back to default ports (5432, 5173, 8000) — Opik and other
# pet-projects already hold those.

# --- host-side ports ---
WEB_PORT=17310
API_PORT=17311
POSTGRES_PORT=17312
ADMINER_PORT=17313

# --- database ---
# Host-side URL (running the API outside Docker):
DATABASE_URL=postgresql+asyncpg://herbatka:herbatka@localhost:17312/herbatka
# Inside the compose network the service listens on the default 5432:
#   postgresql+asyncpg://herbatka:herbatka@db:5432/herbatka
POSTGRES_USER=herbatka
POSTGRES_PASSWORD=herbatka
POSTGRES_DB=herbatka

# --- auth ---
JWT_SECRET=change-me-in-any-non-local-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# OAuth (M1 leaves these blank; the identity table is ready for them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- geocoding (OpenStreetMap Nominatim) ---
# Off by default: the test suite must never depend on a third party being up. Turn it on
# for local use and the admin "Find from address" button starts working. Their policy
# allows one request per second and requires a User-Agent naming the application.
GEOCODING_ENABLED=false

# --- app ---
API_BASE_URL=http://localhost:17311
CORS_ORIGINS=http://localhost:17310

# --- testing on a real phone (all optional, all off by default) ---
# `make dev-lan` binds both servers to 0.0.0.0 so a phone on the same Wi-Fi can
# open the app. Nothing below is needed for that: the phone loads Vite, Vite
# proxies /api to uvicorn server-side, and the browser only ever sees one origin,
# so CORS is not involved.
#
# The two settings below are for the case where the app calls the API *directly*
# — a Capacitor build (origin capacitor://localhost), or a `vite preview` bundle
# pointed somewhere other than its own host. Then it is cross-origin and both
# halves have to be told:
#
#   VITE_API_BASE_URL=http://192.168.1.20:17311
#   CORS_ORIGINS=http://localhost:17310,http://192.168.1.20:17310,capacitor://localhost
#
# Substitute your own address. VITE_API_BASE_URL is read by Vite, so it is baked
# in when the dev server starts or when `npm run build` runs — change it and you
# restart or rebuild, it is not read at runtime. CORS_ORIGINS is read by the API
# at startup, so that one needs uvicorn restarted.
#
# `ipconfig getifaddr en0` prints your address, and `make dev-lan` echoes it on
# startup. Set these in .env, never here: the
# committed default stays pinned to localhost, because a wildcard or a stale LAN
# address in a checked-in file is how a dev API ends up answering the whole
# network. And note that allow_credentials is on, so `*` is not an option the
# CORS spec would honour anyway.
#
# Read web/CAPACITOR.md before pointing a native shell at this: the refresh token
# is an httpOnly cookie, and cross-origin is exactly where it stops arriving.
# VITE_API_BASE_URL=
