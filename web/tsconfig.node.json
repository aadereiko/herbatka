{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // capacitor.config.ts sits here rather than in tsconfig.app.json for the same
  // reason vite.config.ts does: it is build tooling that runs in Node, not app
  // code. Left out of both, nothing would typecheck it at all — `tsc -b` only
  // sees what a project references.
  "include": ["vite.config.ts", "capacitor.config.ts"]
}
