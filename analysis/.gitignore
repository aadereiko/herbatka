# Figures are regenerated by re-running the notebook, and a diff of a PNG helps nobody.
outputs/
.ipynb_checkpoints/
__pycache__/

# Harvested vendor catalogues: the shops' own copy, kept local. The collectors in
# vendor_catalogues/ regenerate every row in about fifteen minutes, so the repository
# keeps the method rather than the harvest. See data/vendor-catalogues/README.md.
data/vendor-catalogues/*
!data/vendor-catalogues/README.md
